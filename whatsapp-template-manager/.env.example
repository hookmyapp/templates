# Nothing here is needed to run the app. The templates are files in this
# folder, and the editor, the previews and the checks all work with no account
# at all. Fill these in to read a real WhatsApp Business account, submit a
# template for review, or send one to your phone.

# An hmat_ token from HookMyApp, or a Meta token with
# whatsapp_business_management. A HookMyApp token goes through the HookMyApp
# gateway, which holds the Meta credentials for you; a Meta token goes straight
# to Graph. The app works out which from the token itself.
WHATSAPP_TOKEN=

# The WhatsApp Business Account the templates belong to.
WABA_ID=

# Only needed to send a test message. This is the number the message is sent
# from, not the number it goes to.
PHONE_NUMBER_ID=

# Not normally needed. Set these to pin a Graph version, or to point the app at
# something other than the host the token implies.
# WHATSAPP_API=https://graph.facebook.com
# WHATSAPP_VERSION=v22.0
