# Postgres connection string, for example from Neon. This is the only one needed.
DATABASE_URL=

# Optional. The same values can be pasted into Settings on the running app,
# which stores them in the database. A value saved there wins over these.
# HOOKMYAPP_API_KEY=
# HOOKMYAPP_WORKSPACE_ID=
# OPENROUTER_API_KEY=

# Only needed when running locally behind a tunnel. On Vercel this is detected.
# PUBLIC_URL=https://your-app.vercel.app
