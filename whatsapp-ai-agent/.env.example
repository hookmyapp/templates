# Postgres connection string, for example from Neon. Needed for a deployment.
# Leave it empty to use the built-in database stored in .pglite, which is
# enough to run everything locally.
DATABASE_URL=

# Optional. The same values can be pasted into Settings on the running app,
# which stores them in the database. A value saved there wins over these.
# HOOKMYAPP_API_KEY=
# HOOKMYAPP_WORKSPACE_ID=
# OPENROUTER_API_KEY=

# Not normally needed. The app reads its own address from the request, so any
# port and any tunnel host work. Set this only when something rewrites the host.
# PUBLIC_URL=https://your-app.example.com

# When using a custom HOOKMYAPP_API_URL, set its sandbox destination number.
# HOOKMYAPP_SANDBOX_PHONE_NUMBER=+17372370900
