# HookMyApp API key (hmok_...). Manages channels, webhooks and channel tokens.
HOOKMYAPP_API_KEY=

# Workspace the channels live in (ws_...).
HOOKMYAPP_WORKSPACE_ID=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Postgres connection string, for example from Neon.
DATABASE_URL=

# Only needed when running locally behind a tunnel. On Vercel this is detected.
# PUBLIC_URL=https://your-app.vercel.app
